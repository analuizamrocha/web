{
  "name": "analu-procto",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='' next dev",
    "dev:turbo": "NODE_OPTIONS='' next dev --turbopack",
    "dev:clean": "rm -rf .next && NODE_OPTIONS='' next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true npm run build",
    "lighthouse": "lighthouse http://localhost:3000 --output=json,html --output-path=./lighthouse-results --view",
    "lighthouse:prod": "lighthouse https://analuizarocha.com.br --output=json,html --output-path=./lighthouse-results --view",
    "lighthouse:ci": "lighthouse http://localhost:3000 --output=json --quiet --chrome-flags='--headless --no-sandbox'"
  },
  "dependencies": {
    "@next/third-parties": "^15.3.6",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "caniuse-lite": "^1.0.30001748",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.503.0",
    "next": "15.3.6",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.10.2",
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.5.4",
    "@tailwindcss/postcss": "^4.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.10.3",
    "chrome-launcher": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "jsdom": "^25.0.1",
    "lighthouse": "^12.8.2",
    "react-grab": "^0.1.16",
    "schema-dts": "^1.1.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
